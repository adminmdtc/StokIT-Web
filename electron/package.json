{
  "name": "it-stock",
  "version": "1.2.0",
  "description": "ระบบบริหารจัดการวัสดุและอุปกรณ์ กลุ่มงานเทคโนโลยีสารสนเทศ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "IT Department",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "publish": {
    "provider": "github",
    "owner": "adminmdtc",
    "repo": "StokIT-Web",
    "releaseType": "release"
  },
  "build": {
    "appId": "com.itstock.desktop",
    "productName": "IT Stock",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "app-update.yml",
      "main.js",
      "updater.js",
      "update.html",
      "package.json",
      "web/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IT Stock",
      "artifactName": "IT-Stock-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "IT-Stock-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  }
}
